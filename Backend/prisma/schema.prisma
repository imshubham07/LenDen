generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

model User {
  id           String     @id @default(cuid())
  name         String
  mobile       String     @unique
  recoveryCodeHash String?
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  borrowers    Borrower[]
  loans        Loan[]
  payments     Payment[]

  @@map("Admin")
}

model Borrower {
  id                String    @id @default(cuid())
  userId            String    @map("adminId")
  name              String
  fatherOrHusband   String
  documentNote      String?
  village           String
  mobile            String
  monthlyPercentage Decimal   @db.Decimal(5, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Borrower_adminId_fkey")
  loans             Loan[]
  payments          Payment[]

  @@unique([userId, mobile], map: "Borrower_adminId_mobile_key")
  @@index([userId], map: "Borrower_adminId_idx")
  @@index([name])
  @@index([mobile])
}

model Loan {
  id         String     @id @default(cuid())
  userId     String     @map("adminId")
  borrowerId String
  amount     Decimal    @db.Decimal(12, 2)
  purpose    String
  givenDate  DateTime
  guarantor  String?
  status     LoanStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Loan_adminId_fkey")
  borrower   Borrower   @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Loan_adminId_idx")
  @@index([borrowerId])
  @@index([givenDate])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String   @map("adminId")
  borrowerId  String
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Payment_adminId_fkey")
  borrower    Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Payment_adminId_idx")
  @@index([borrowerId])
  @@index([paymentDate])
}
